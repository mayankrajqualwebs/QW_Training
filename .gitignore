# ==============================================================================
# THE ULTIMATE UNIVERSAL .GITIGNORE
# Targets: OS Clutter, IDEs, Security, Web, Python, Mobile, DevOps, and Databases
# ==============================================================================

# ==========================================
# 1. SYSTEM & OPERATING SYSTEMS
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
~
.fuse_hidden
.directory
.Trash-*
.nfs*

# ==========================================
# 2. IDEs, EDITORS & TOOLING
# ==========================================
# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
.history/
*.code-workspace
.ionide/

# JetBrains (PyCharm, WebStorm, IntelliJ, Rider, etc.)
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse, NetBeans, Visual Studio
.project
.classpath
.settings/
*.suo
*.user
*.userosscache
*.sln.docstates
*.patch
*.diff

# Sublime Text / Vim
*.sublime-project
*.sublime-workspace
*.swp
*.swo
.netrwhist

# ==========================================
# 3. SECURITY, ENVIRONMENT & SECRETS (NEVER PUSH)
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.secret
credentials.json
auth.json
Signing.key

# ==========================================
# 4. PYTHON (FastAPI, Django, Flask, Data Science)
# ==========================================
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.ipynb_checkpoints
.venv/
venv/
ENV/
env/
dist/
build/
*.egg-info/
.eggs/

# ==========================================
# 5. JAVASCRIPT & WEB DEVELOPMENT (Node, React, Next.js, Vue)
# ==========================================
node_modules/
bower_components/
jspm_packages/
.pnp/
.pnp.js
.next/
.nuxt/
.svelte-kit/
.turbo/
dist/
out/
build/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.prettiercache
tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# 6. MOBILE & DESKTOP DEVELOPEMENT (Flutter, Android, iOS)
# ==========================================
# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
/build/

# Android
.gradle/
local.properties
capture/
*.apk
*.ap_
*.aab

# iOS / CocoaPods
Pods/
DerivedData/
*.moved-aside
*.xcuserstate

# ==========================================
# 7. BACKEND languages (Java, Go, Rust, C++)
# ==========================================
# Java / Maven / Gradle
target/
.gradle/
build/
*.class

# Go
/bin/
/pkg/
out/

# Rust
/target/
Cargo.lock

# C / C++
*.o
*.obj
*.out
*.exe
*.dll
*.so
*.dylib

# ==========================================
# 8. DATABASES & CACHING
# ==========================================
*.db
*.sqlite
*.sqlite3
*.log
*.sql
*.dump
.redis/

# ==========================================
# 9. CONTAINERIZATION & DEVOPS
# ==========================================
.terraform/
*.tfstate
*.tfstate.backup
.vagrant/
.kube/
